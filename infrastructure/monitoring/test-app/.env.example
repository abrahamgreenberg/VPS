# Copy to .env before `docker compose up`.

# Point at the public Alloy OTLP/HTTP gateway (via Traefik), or at
# http://alloy:4318 if you attach this compose project to monitoring-network
# directly instead of going over the internet.
OTEL_EXPORTER_OTLP_ENDPOINT=https://alloy.abrahamgreenberg.co.uk

# Comma-separated key=value pairs, sent as request headers on every OTLP call.
# Generate the basic-auth value with:
#   echo -n 'alloy-user:your-password' | base64
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic CHANGEME"

DEPLOYMENT_ENV=demo
