// Prisma schema for authentication server
// Uses PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Whitelist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
