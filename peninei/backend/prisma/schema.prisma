// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("BACKEND_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id       Int       @id @default(autoincrement())
  title    String    @unique
  halachot Halacha[]
}

model Halacha {
  id            Int           @id @default(autoincrement())
  heTitle       String
  enTitle       String? // optional English title
  heText        String
  url           String        @unique
  date          DateTime      @default(now()) @db.Date
  parseWithAi   Boolean       @default(false)
  chapterNumber Int?
  halachaNumber Int?
  bookId        Int?
  book          Book?         @relation(fields: [bookId], references: [id])
  lines         HalachaLine[] // relation to line-by-line translation

  @@index([date])
}

model HalachaLine {
  id        Int     @id @default(autoincrement())
  hebrew    String
  english   String
  halacha   Halacha @relation(fields: [halachaId], references: [id])
  halachaId Int

  @@index([halachaId])
}
