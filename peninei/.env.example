BACKEND_DATABASE_URL="postgresql://username:password@host:port/database?schema=public"
BACKEND_OPEN_API_KEY="your-open-api-key-here"
BACKEND_AI_MAX_ATTEMPTS=3
BACKEND_API_PORT=5000
BACKEND_CORS_ALLOWED_URL="http://localhost:3000"
BACKEND_RATE_LIMIT_MAX_REQUESTS=50
BACKEND_RATE_LIMIT_WINDOW_MS=60000

# Metrics/logs are shipped to the shared monitoring stack's Alloy collector.
# http://alloy:4318 works when this compose project is attached to
# monitoring-network directly (see docker-compose.yml); no auth needed on
# that internal overlay network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
DEPLOYMENT_ENV=production

VITE_FRONTEND_API_URL="http://localhost:5000/api"
FRONTEND_API_PORT=3000